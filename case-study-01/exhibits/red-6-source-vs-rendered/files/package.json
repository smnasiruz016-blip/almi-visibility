{
  "name": "almi-italian",
  "version": "0.1.0",
  "description": "AlmiItalian — honest CILS + CELI exam practice. Three isolated scoring engines (CILS standard, CILS B1 Cittadinanza, CELI); Writing/Speaking = AI estimate.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run gate:fork-hygiene && npm run seo:test && npm run selftest:engine && npm run gate:status-band && npm run gate:exam-verdict && npm run gate:contrast && npm run gate:criterion-band && npm run gate:derived-verdict && npm run validate:batch1 && npm run gate:bank && npm run gate:item-id && npm run gate:serve && npm run gate:degame && npm run gate:coverage && npm run gate:security && npm run gate:real-entity && npm run gate:titles && node scripts/seo/uniqueness-gate.mjs && npm run gate:entitlement && npm run gate:ascolto-audio && npm run gate:ai-cost && npm run gate:ai-ledger && npm run gate:honesty && npm run gate:ai-e2e && npm run gate:marking && npm run gate:reveal && npm run gate:content:full && npm run gate:static-shell && npm run gate:token:full && npm run gate:webhook-idempotency && npm run gate:billing-health && npm run gate:spend-limits && npm run gate:audio-retention && npm run gate:speaking-claims && npm run gate:summary-consistency && npm run gate:sidebar && prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "seo:data": "python scripts/seo/build-data.py",
    "seo:test": "node scripts/seo/exclusions.selftest.mjs && tsx scripts/seo/content.selftest.ts",
    "selftest:engine": "tsx src/lib/scoring/scoring.selftest.ts",
    "gate:status-band": "tsx scripts/gates/status-band-gate.mts",
    "gate:exam-verdict": "tsx scripts/gates/exam-verdict-gate.mts",
    "gate:contrast": "tsx scripts/gates/contrast-gate.mts",
    "gate:criterion-band": "tsx scripts/gates/criterion-band-gate.mts",
    "gate:derived-verdict": "tsx scripts/gates/derived-verdict-gate.mts",
    "validate:batch1": "tsx scripts/seed/batch1/batch1.selftest.ts",
    "seed:batch1": "tsx scripts/seed/seed-batch1.ts",
    "db:deploy": "prisma migrate deploy",
    "gate:fork-hygiene": "node scripts/seo/fork-hygiene-gate.mjs",
    "gate:bank": "tsx scripts/items/bank-gate.mts",
    "gate:item-id": "tsx scripts/items/id-gate.mts",
    "gate:serve": "tsx scripts/items/serve-gate.mts",
    "gate:degame": "tsx scripts/items/degame-gate.mts",
    "gate:coverage": "tsx scripts/items/coverage-gate.mts",
    "gate:real-entity": "tsx scripts/items/real-entity-gate.mts",
    "gate:titles": "tsx scripts/items/title-uniqueness-gate.mts",
    "gate:security": "tsx scripts/items/security-gate.mts",
    "gate:entitlement": "tsx scripts/billing/entitlement.selftest.ts",
    "gate:ascolto-audio": "tsx scripts/gates/ascolto-audio-gate.mts",
    "audio:render": "tsx scripts/audio/render-ascolto.mts",
    "gate:ai-cost": "tsx scripts/gates/ai-cost-gate.mts",
    "gate:ai-ledger": "tsx scripts/gates/ai-ledger-gate.mts",
    "gate:honesty": "tsx scripts/gates/honesty-gate.mts",
    "gate:ai-e2e": "tsx scripts/ai/mock-e2e.mts",
    "gate:marking": "tsx scripts/gates/marking-gate.mts",
    "gate:reveal": "tsx scripts/gates/reveal-gate.mts",
    "gate:content": "tsx scripts/gates/content-gate.mts",
    "gate:static-shell": "tsx scripts/gates/static-shell-gate.mts",
    "gate:token": "tsx scripts/gates/token-gate.mts",
    "gate:token:full": "tsx scripts/gates/token-gate.mts --expect-full",
    "gate:webhook-idempotency": "tsx scripts/gates/webhook-idempotency-gate.mts",
    "gate:billing-health": "tsx scripts/gates/billing-health-gate.mts",
    "gate:spend-limits": "tsx scripts/gates/spend-limits-gate.mts",
    "gate:audio-retention": "tsx scripts/gates/audio-retention-gate.mts",
    "gate:speaking-claims": "tsx scripts/gates/speaking-claims-gate.mts",
    "gate:summary-consistency": "tsx scripts/gates/summary-consistency-gate.mts",
    "gate:sidebar": "tsx scripts/gates/sidebar-gate.mts",
    "gate:content:full": "tsx scripts/gates/content-gate.mts --expect-full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@prisma/client": "^6.19.3",
    "@smnasiruz016-blip/almi-data": "^0.5.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.25"
  }
}
